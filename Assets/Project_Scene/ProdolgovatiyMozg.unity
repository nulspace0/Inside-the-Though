  - "\u041F\u0440\u043E\u0434\u043E\u043B\u0433\u043E\u0432\u0430\u0442\u044B\u0439
    \u043C\u043E\u0437\u0433 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u0442
    \u0434\u044B\u0445\u0430\u043D\u0438\u0435 \u2014 \u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
    \u0434\u0430\u0436\u0435 \u043F\u043E\u043A\u0430 \u0442\u044B \u0441\u043F\u0438\u0448\u044C"
  - "\u0421\u0435\u0440\u0434\u0446\u0435\u0431\u0438\u0435\u043D\u0438\u0435, \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435,
    \u0433\u043B\u043E\u0442\u0430\u043D\u0438\u0435 \u2014 \u0432\u0441\u0435\u043C
    \u044D\u0442\u0438\u043C \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442
    \u043F\u0440\u043E\u0434\u043E\u043B\u0433\u043E\u0432\u0430\u0442\u044B\u0439
    \u043C\u043E\u0437\u0433"
  - "\u042D\u0442\u043E \u0441\u0430\u043C\u044B\u0439 \u0434\u0440\u0435\u0432\u043D\u0438\u0439
    \u043E\u0442\u0434\u0435\u043B \u043C\u043E\u0437\u0433\u0430 \u2014 \u043E\u043D
    \u0435\u0441\u0442\u044C \u0434\u0430\u0436\u0435 \u0443 \u0440\u044B\u0431"
  - "\u041C\u043E\u0437\u0433 \u043D\u0435 \u0443\u043C\u0435\u0435\u0442 \u0434\u0435\u043B\u0430\u0442\u044C
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u0435\u043B \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
    \u2014 \u043E\u043D \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u044B\u0441\u0442\u0440\u043E
    \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F"
  - " \u041C\u0443\u0437\u044B\u043A\u0430 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u043E\u043D \u043C\u043E\u0437\u0433\u0430,
    \u0447\u0435\u043C \u043B\u044E\u0431\u043E\u0439 \u0434\u0440\u0443\u0433\u043E\u0439
    \u0441\u0442\u0438\u043C\u0443\u043B"
  - "\u041D\u043E\u0432\u044B\u0435 \u043D\u0435\u0439\u0440\u043E\u043D\u044B \u0440\u043E\u0436\u0434\u0430\u044E\u0442\u0441\u044F
    \u0432 \u043C\u043E\u0437\u0433\u0435 \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438
    \u0432\u0441\u0435\u0439 \u0436\u0438\u0437\u043D\u0438"
  - "\u0427\u0442\u0435\u043D\u0438\u0435 \u0432\u0441\u043B\u0443\u0445 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442
    \u043C\u043E\u0437\u0433 \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0447\u0435\u043C
    \u0447\u0442\u0435\u043D\u0438\u0435 \u043F\u0440\u043E \u0441\u0435\u0431\u044F"
  - "\u041F\u0440\u043E\u0434\u043E\u043B\u0433\u043E\u0432\u0430\u0442\u044B\u0439
    \u043C\u043E\u0437\u0433 \u043D\u0435 \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u2014 \u0434\u0430\u0436\u0435 \u043F\u043E\u0434
    \u043D\u0430\u0440\u043A\u043E\u0437\u043E\u043C"
