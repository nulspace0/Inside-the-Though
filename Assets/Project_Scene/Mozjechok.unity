--- !u!114 &935453746
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 935453742}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 531d919798e122142a5243bf64d9a63d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BalloonSpawner
  balloonPrefab: {fileID: 5036082926214154955, guid: ba5ab0e005ff51c4cb4263038fbf5da3, type: 3}
  spawnInterval: 5
  maxBalloons: 8
  minRadius: 1
  maxRadius: 2.5
  spawnHeight: 1.2
  brainFacts:
  - "\u041C\u043E\u0437\u0436\u0435\u0447\u043E\u043A \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442
    \u0432\u0441\u0435\u0433\u043E 10% \u043C\u043E\u0437\u0433\u0430, \u043D\u043E
    \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 50% \u0432\u0441\u0435\u0445
    \u043D\u0435\u0439\u0440\u043E\u043D\u043E\u0432"
  - "\u041C\u043E\u0437\u0436\u0435\u0447\u043E\u043A \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
    \u0437\u0430 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0446\u0438\u044E
    \u2014 \u0431\u0435\u0437 \u043D\u0435\u0433\u043E \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
    \u0445\u043E\u0434\u0438\u0442\u044C \u043F\u0440\u044F\u043C\u043E"
  - "\u041C\u043E\u0437\u0436\u0435\u0447\u043E\u043A \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u2014 \u0442\u0430\u043A \u043C\u044B\u0448\u0446\u044B
    \u0443\u0447\u0430\u0442\u0441\u044F \u0438\u0433\u0440\u0430\u0442\u044C \u043D\u0430
    \u0433\u0438\u0442\u0430\u0440\u0435 \u0438\u043B\u0438 \u043A\u0430\u0442\u0430\u0442\u044C\u0441\u044F
    \u043D\u0430 \u0432\u0435\u043B\u043E\u0441\u0438\u043F\u0435\u0434\u0435\n"
  - " \u0412\u043E \u0441\u043D\u0435 \u043C\u043E\u0437\u0433 \u043E\u0447\u0438\u0449\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u0442\u043E\u043A\u0441\u0438\u043D\u043E\u0432"
  - "\u0421\u043A\u0443\u043A\u0430 \u2014 \u044D\u0442\u043E \u0441\u0438\u0433\u043D\u0430\u043B
    \u043C\u043E\u0437\u0433\u0430 \u0447\u0442\u043E \u043E\u043D \u043D\u0435\u0434\u043E\u0433\u0440\u0443\u0436\u0435\u043D
    \u0438 \u0445\u043E\u0447\u0435\u0442 \u043D\u043E\u0432\u044B\u0445 \u0437\u0430\u0434\u0430\u0447"
  - "\u0421\u043C\u0435\u0445 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442
    \u0441\u0440\u0430\u0437\u0443 \u043F\u044F\u0442\u044C \u0440\u0430\u0437\u043D\u044B\u0445
    \u043E\u0431\u043B\u0430\u0441\u0442\u0435\u0439 \u043C\u043E\u0437\u0433\u0430
    \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E"
  - "\u041C\u043E\u0437\u0433 \u0430\u043A\u0442\u0438\u0432\u043D\u0435\u0435 \u043D\u043E\u0447\u044C\u044E,
    \u0447\u0435\u043C \u0434\u043D\u0451\u043C"
  - " \u041C\u043E\u0437\u0433 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442
    \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E \u0431\u043E\u043B\u044C
    \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0443\u044E"
  - "\u0421\u0442\u0440\u0435\u0441\u0441 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
    \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442 \u043C\u043E\u0437\u0433
    \u2014 \u043E\u043D \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u0435\u0442 \u043D\u0435\u0439\u0440\u043E\u043D\u043D\u044B\u0435
    \u0441\u0432\u044F\u0437\u0438"
