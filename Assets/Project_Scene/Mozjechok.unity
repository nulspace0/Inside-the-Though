    \u041C\u043E\u0437\u0436\u0435\u0447\u043E\u043A \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442
    \u0440\u0430\u0437\u043D\u044B\u0435 \u0447\u0430\u0441\u0442\u0438 \u043C\u043E\u0437\u0433\u0430,
    \u043A\u0430\u043A \u0440\u043E\u0443\u0442\u0435\u0440 \u2014 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430,
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F \u0441\u043B\u0430\u0436\u0435\u043D\u043D\u0443\u044E
    \u0440\u0430\u0431\u043E\u0442\u0443 \u0432\u0441\u0435\u0445 \u0441\u0438\u0441\u0442\u0435\u043C
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F."
