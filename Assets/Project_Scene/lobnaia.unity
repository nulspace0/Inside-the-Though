  spawnHeight: 1.2
  brainFacts:
  - "\U0001F9E0 \u041C\u043E\u0437\u0433 \u043D\u0430 73% \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u0432\u043E\u0434\u044B"
  - "\u041B\u043E\u0431\u043D\u0430\u044F \u0434\u043E\u043B\u044F \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u0442
    \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u044B \u2014 \u0431\u0435\u0437 \u043D\u0435\u0451
    \u043C\u044B \u0431\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
    \u043D\u0435 \u0434\u0443\u043C\u0430\u044F"
  - "\u041B\u043E\u0431\u043D\u0430\u044F \u0434\u043E\u043B\u044F \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
    \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C \u0447\u0443\u0436\u0438\u0435
    \u044D\u043C\u043E\u0446\u0438\u0438 \u0438 \u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u0441\u0435\u0431\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u043E \u0434\u0440\u0443\u0433\u043E\u0433\u043E"
  - " \u0412\u043E \u0441\u043D\u0435 \u043C\u043E\u0437\u0433 \u043E\u0447\u0438\u0449\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u0442\u043E\u043A\u0441\u0438\u043D\u043E\u0432"
  - " \u041C\u0443\u0437\u044B\u043A\u0430 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u043E\u043D \u043C\u043E\u0437\u0433\u0430,
    \u0447\u0435\u043C \u043B\u044E\u0431\u043E\u0439 \u0434\u0440\u0443\u0433\u043E\u0439
    \u0441\u0442\u0438\u043C\u0443\u043B"
  - " \u041C\u043E\u0437\u0433 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u0434\u043E
    25 \u043B\u0435\u0442"
  - "\u041C\u043E\u0437\u0433 \u0430\u043A\u0442\u0438\u0432\u043D\u0435\u0435 \u043D\u043E\u0447\u044C\u044E,
    \u0447\u0435\u043C \u0434\u043D\u0451\u043C"
  - " \u041C\u043E\u0437\u0433 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442
    \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E \u0431\u043E\u043B\u044C
    \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0443\u044E"
  - "\u041B\u043E\u0431\u043D\u0430\u044F \u0434\u043E\u043B\u044F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0442\u0440\u0435\u0442\u044C \u0432\u0441\u0435\u0433\u043E \u043E\u0431\u044A\u0451\u043C\u0430
    \u043C\u043E\u0437\u0433\u0430"
