  displayText: "\u041E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u0437\u0432\u0443\u043A\u0430.
    \u0412\u0438\u0441\u043E\u0447\u043D\u0430\u044F \u0434\u043E\u043B\u044F \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u044B\u0432\u0430\u0435\u0442
    \u0440\u0435\u0447\u044C, \u043A\u0430\u043A \u0440\u0430\u0446\u0438\u044F \u2014
    \u0440\u0430\u0434\u0438\u043E\u0441\u0438\u0433\u043D\u0430\u043B\u044B, \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044F
    \u0448\u0443\u043C \u0432 \u0441\u043C\u044B\u0441\u043B"
