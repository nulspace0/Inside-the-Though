  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GazeTargetData
  displayText: "\u041C\u0438\u0440 \u0432\u043E \u0441\u043D\u0435. \u0417\u0430\u0442\u044B\u043B\u043E\u0447\u043D\u0430\u044F
    \u0434\u043E\u043B\u044F \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
    \u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043E\u0431\u0440\u0430\u0437\u044B,
    \u0434\u0430\u0436\u0435 \u043A\u043E\u0433\u0434\u0430 \u0432\u044B \u0441\u043F\u0438\u0442\u0435
    \u2014 \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044F \u0441\u043D\u044B, \u043A\u0430\u043A
    \u0444\u0438\u043B\u044C\u043C\u044B \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435\xBB."
