  m_Script: {fileID: 11500000, guid: 531d919798e122142a5243bf64d9a63d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BalloonSpawner
  balloonPrefab: {fileID: 5036082926214154955, guid: ba5ab0e005ff51c4cb4263038fbf5da3, type: 3}
  spawnInterval: 5
  maxBalloons: 8
  minRadius: 1
  maxRadius: 2.5
  spawnHeight: 1.2
  brainFacts:
  - "\u0412\u0438\u0441\u043E\u0447\u043D\u0430\u044F \u0434\u043E\u043B\u044F \u2014
    \u044D\u0442\u043E \u0442\u0432\u043E\u044F \u043F\u0430\u043C\u044F\u0442\u044C.
    \u0417\u0434\u0435\u0441\u044C \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F
    \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F"
  - "\u0412\u0438\u0441\u043E\u0447\u043D\u0430\u044F \u0434\u043E\u043B\u044F \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0451\u0442
    \u043B\u0438\u0446\u0430 \u2014 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u0434\u0435\u043B\u0430\u0435\u0442 \u043B\u044E\u0434\u0435\u0439 \u043D\u0435\u0443\u0437\u043D\u0430\u0432\u0430\u0435\u043C\u044B\u043C\u0438"
  - "\u0417\u0434\u0435\u0441\u044C \u0436\u0438\u0432\u0451\u0442 \u0440\u0435\u0447\u044C
    \u2014 \u0432\u0438\u0441\u043E\u0447\u043D\u0430\u044F \u0434\u043E\u043B\u044F
    \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442 \u0441\u043B\u043E\u0432\u0430
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0442\u044B \u0441\u043B\u044B\u0448\u0438\u0448\u044C"
  - "\u041C\u0443\u0437\u044B\u043A\u0430 \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0438\u043C\u0435\u043D\u043D\u043E \u0432 \u0432\u0438\u0441\u043E\u0447\u043D\u043E\u0439
    \u0434\u043E\u043B\u0435"
  - " \u041C\u0443\u0437\u044B\u043A\u0430 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u043E\u043D \u043C\u043E\u0437\u0433\u0430,
    \u0447\u0435\u043C \u043B\u044E\u0431\u043E\u0439 \u0434\u0440\u0443\u0433\u043E\u0439
