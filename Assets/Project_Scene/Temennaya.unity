  m_text: "\u0422\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u0434\u043E\u043B\u044F
    \u2014 \"\u0441\u0435\u043D\u0441\u043E\u0440\u043D\u044B\u0439 \u0446\u0435\u043D\u0442\u0440\",
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
    \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044F \u043E\u0442 \u043F\u0440\u0438\u043A\u043E\u0441\u043D\u043E\u0432\u0435\u043D\u0438\u0439,
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
    \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0438
    \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
    \u0441 \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u043C\u0438.\r\n\u0412\u043C\u0435\u0441\u0442\u0435
    \u043E\u043D\u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0432\u0438\u0434\u0435\u0442\u044C,
    \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C,
    \u0433\u0434\u0435 \u0432\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435\u0441\u044C
    \u0438 \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u0432\u043E\u043A\u0440\u0443\u0433."
