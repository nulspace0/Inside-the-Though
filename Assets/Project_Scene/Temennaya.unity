--- !u!114 &1166865323
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1166865319}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 531d919798e122142a5243bf64d9a63d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BalloonSpawner
  balloonPrefab: {fileID: 5036082926214154955, guid: ba5ab0e005ff51c4cb4263038fbf5da3, type: 3}
  spawnInterval: 3
  maxBalloons: 8
  minRadius: 1
  maxRadius: 2.5
  spawnHeight: 1.2
  brainFacts:
  - "\u0417\u0430\u0442\u044B\u043B\u043E\u0447\u043D\u0430\u044F \u0434\u043E\u043B\u044F
    \u2014 \u044D\u0442\u043E \u0432\u0430\u0448\u0438 \u0433\u043B\u0430\u0437\u0430
    \u0432 \u043C\u043E\u0437\u0433\u0435. \u041E\u043D\u0430 \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
    \u0432\u0441\u0451 \u0447\u0442\u043E \u0442\u044B \u0432\u0438\u0434\u0438\u0448\u044C"
  - "\u0422\u043E \u0447\u0442\u043E \u0442\u044B \u0432\u0438\u0434\u0438\u0448\u044C
    \u0441\u0435\u0439\u0447\u0430\u0441 \u2014 \u043D\u0430 \u0441\u0430\u043C\u043E\u043C
    \u0434\u0435\u043B\u0435 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u0430\u044F
    \u0437\u0430\u0442\u044B\u043B\u043E\u0447\u043D\u043E\u0439 \u0434\u043E\u043B\u0435\u0439"
  - "\u041C\u043E\u0437\u0433 \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0441 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u043E\u0439
    \u2014 \u043C\u044B \u0436\u0438\u0432\u0451\u043C \u043D\u0430 80 \u043C\u0438\u043B\u043B\u0438\u0441\u0435\u043A\u0443\u043D\u0434
    \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C"
  - "\u0422\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u0434\u043E\u043B\u044F \u0433\u043E\u0432\u043E\u0440\u0438\u0442
    \u0442\u0435\u0431\u0435 \u0433\u0434\u0435 \u0442\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0448\u044C\u0441\u044F
    \u0432 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435"
  - "\u0422\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u0434\u043E\u043B\u044F \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u0435\u0442
    \u043E\u0441\u044F\u0437\u0430\u043D\u0438\u0435, \u0437\u0440\u0435\u043D\u0438\u0435
    \u0438 \u0441\u043B\u0443\u0445 \u0432 \u0435\u0434\u0438\u043D\u0443\u044E \u043A\u0430\u0440\u0442\u0438\u043D\u0443
    \u043C\u0438\u0440\u0430"
  - "\u0411\u0435\u0437 \u0442\u0435\u043C\u0435\u043D\u043D\u043E\u0439 \u0434\u043E\u043B\u0438
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C \u0433\u0434\u0435
    \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0435\u0433\u043E \u0442\u0435\u043B\u043E"
  - "\u041C\u043E\u0437\u0433 \u0430\u043A\u0442\u0438\u0432\u043D\u0435\u0435 \u043D\u043E\u0447\u044C\u044E,
    \u0447\u0435\u043C \u0434\u043D\u0451\u043C"
  - " \u041C\u043E\u0437\u0433 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442
    \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E \u0431\u043E\u043B\u044C
    \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0443\u044E"
